# Copy to .env and fill in. NEVER commit .env or your .pem key.

# "demo" = Kalshi's paper exchange (separate account + keys at demo.kalshi.co). Switch to "prod" only
# after paper-trading results justify it.
KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi-private-key.pem

# Optional: sportsbook prices from https://the-odds-api.com (free tier = 500 credits/month)
ODDS_API_KEY=
# ODDS_MARKETS=h2h,spreads,totals,player_points,player_rebounds,player_assists,player_threes

# Risk limits in dollars
BANKROLL=100
MAX_STAKE_PER_COMBO=2
MAX_DAILY_STAKE=10
KELLY_FRACTION=0.1

# Blend weights (rest goes to the Kalshi price)
W_MODEL=0.4
W_BOOK=0.4
# Assumed market-maker margin on combo quotes, used only for the pre-RFQ estimate
COMBO_VIG=0.10
